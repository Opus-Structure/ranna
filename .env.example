# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npx supabase status` after `npm run db:start`.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
# Local direct connection. On Vercel use the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Random 32+ byte string: salts IP hashes and signs internal tokens. `openssl rand -base64 32`
APP_SECRET=
# Web Push (generate with `npm run vapid`)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Payments: comma-separated list of enabled providers (mock, manual, chargily)
PAYMENT_PROVIDERS=mock,manual
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
# Email for reminders and staff invites: log | resend
MAILER=log
RESEND_API_KEY=
MAIL_FROM="Ranna <no-reply@example.com>"
# Fallback alerts: mock (real SMS/WhatsApp adapters plug in later)
SMS_PROVIDER=mock

# --- Seed only (local) ---
SEED_ADMIN_EMAIL=admin@ranna.local
SEED_ADMIN_PASSWORD=
