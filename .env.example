# Copy to .env.local and fill in (or run `npm run setup:env`). Never commit real values.
# Postgres runs locally (`npm run db:start`); Neon Auth, Realtime and Object Storage live on a Neon
# branch (create a dev branch of your project and copy its values).

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Base URL of the public `merchant-assets` bucket: <S3_ENDPOINT>/merchant-assets
NEXT_PUBLIC_ASSETS_URL=
# Neon Realtime socket URL (same value as NEON_REALTIME_URL). Empty = pages poll instead.
NEXT_PUBLIC_REALTIME_URL=

# --- Server only ---
# Local Postgres. On Vercel use the Neon pooled URL (host contains -pooler), with ?sslmode=require
# and nothing else (no channel_binding).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Random 32+ byte string: salts IP hashes and signs internal tokens. `openssl rand -base64 32`
APP_SECRET=

# Managed Better Auth (Neon): Console → Auth → Configuration, plus a 32+ char cookie secret
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon Realtime (live order updates): Console → Realtime
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Neon Object Storage (S3 API): create a credential with storage:read + storage:write
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web Push (generate with `npm run vapid`)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
# Payments: comma-separated list of enabled providers (mock, manual, chargily)
PAYMENT_PROVIDERS=mock,manual
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
# Email for reminders and staff invites: log | resend
MAILER=log
RESEND_API_KEY=
MAIL_FROM="Ranna <no-reply@example.com>"
# Fallback alerts: mock (real SMS/WhatsApp adapters plug in later)
SMS_PROVIDER=mock

# --- Seed only ---
SEED_ADMIN_EMAIL=admin@ranna.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@ranna.local
SEED_DEMO_PASSWORD=
